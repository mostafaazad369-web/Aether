diff --git a/src/hev-socks5-tunnel.c b/src/hev-socks5-tunnel.c
index 0000000..0000000 100644
--- a/src/hev-socks5-tunnel.c
+++ b/src/hev-socks5-tunnel.c
@@ -48,6 +48,23 @@ enum
 static int run;
 static atomic_int tsync;
 
+/*
+ * Serialize quit against tunnel finalization. tsync alone is not sufficient:
+ * a late quit after fini clears SYNC_SEND can leave SYNC_STOP set for the next
+ * invocation because tsync is process-global.
+ */
+static atomic_flag lifecycle_gate = ATOMIC_FLAG_INIT;
+static int lifecycle_active;
+
+static void
+lifecycle_lock (void)
+{
+    while (atomic_flag_test_and_set_explicit (&lifecycle_gate,
+                                               memory_order_acquire))
+        ;
+}
+
+static void
+lifecycle_unlock (void)
+{
+    atomic_flag_clear_explicit (&lifecycle_gate, memory_order_release);
+}
+
 static int tun_fd = -1;
@@ -770,6 +787,9 @@ hev_socks5_tunnel_init (int tun_fd)
     hev_task_mutex_init (&mutex);
 
     atomic_fetch_or (&tsync, SYNC_SEND);
+    lifecycle_lock ();
+    lifecycle_active = 1;
+    lifecycle_unlock ();
 
     return 0;
@@ -783,6 +803,9 @@ hev_socks5_tunnel_fini (void)
 {
     LOG_D ("socks5 tunnel fini");
 
+    lifecycle_lock ();
+    lifecycle_active = 0;
+    lifecycle_unlock ();
+
 retry:
@@ -841,6 +864,12 @@ hev_socks5_tunnel_stop (void)
 {
     int res;
 
+    lifecycle_lock ();
+    if (!lifecycle_active) {
+        lifecycle_unlock ();
+        return;
+    }
+
 retry:
@@ -857,6 +886,7 @@ retry:
     }
 
     atomic_fetch_and (&tsync, ~SYNC_WAIT);
+    lifecycle_unlock ();
 }

diff --git a/src/hev-socks5-tunnel.c b/src/hev-socks5-tunnel.c
--- a/src/hev-socks5-tunnel.c
+++ b/src/hev-socks5-tunnel.c
@@ -58,4 +58,26 @@
 static int run;
 static atomic_int tsync;
 
+/*
+ * Serialize quit against tunnel finalization. Generation checks prevent a
+ * delayed stop from an old bridge worker from reaching a newer invocation.
+ */
+static atomic_flag lifecycle_gate = ATOMIC_FLAG_INIT;
+static int lifecycle_active;
+static uint64_t lifecycle_generation;
+
+static void
+lifecycle_lock (void)
+{
+    while (atomic_flag_test_and_set_explicit (&lifecycle_gate,
+                                               memory_order_acquire))
+        ;
+}
+
+static void
+lifecycle_unlock (void)
+{
+    atomic_flag_clear_explicit (&lifecycle_gate, memory_order_release);
+}
+
 static int tun_fd = -1;
@@ -803,3 +825,3 @@
 int
-hev_socks5_tunnel_init (int tun_fd)
+hev_socks5_tunnel_init (int tun_fd, uint64_t generation)
 {
@@ -838,5 +860,9 @@
     hev_task_mutex_init (&mutex);
 
+    lifecycle_lock ();
+    lifecycle_active = 1;
+    lifecycle_generation = generation;
     atomic_fetch_or (&tsync, SYNC_SEND);
+    lifecycle_unlock ();
 
     return 0;
@@ -852,4 +878,9 @@
 {
     LOG_D ("socks5 tunnel fini");
 
+    lifecycle_lock ();
+    lifecycle_active = 0;
+    lifecycle_generation = 0;
+    lifecycle_unlock ();
+
 retry:
@@ -896,12 +927,19 @@
-void
-hev_socks5_tunnel_stop (void)
+static void
+hev_socks5_tunnel_stop_internal (uint64_t generation, int check_generation)
 {
     int res;
 
     LOG_D ("socks5 tunnel stop");
 
+    lifecycle_lock ();
+    if (!lifecycle_active ||
+        (check_generation && lifecycle_generation != generation)) {
+        lifecycle_unlock ();
+        return;
+    }
+
 retry:
     res = atomic_fetch_or (&tsync, SYNC_WAIT);
     if (res & SYNC_WAIT) {
         usleep (500);
         goto retry;
@@ -919,4 +957,17 @@
     }
 
     atomic_fetch_and (&tsync, ~SYNC_WAIT);
+    lifecycle_unlock ();
+}
+
+void
+hev_socks5_tunnel_stop (void)
+{
+    hev_socks5_tunnel_stop_internal (0, 0);
+}
+
+void
+hev_socks5_tunnel_stop_generation (uint64_t generation)
+{
+    hev_socks5_tunnel_stop_internal (generation, 1);
 }
